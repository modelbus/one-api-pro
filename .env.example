PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# ========================
# 数据库配置
# ========================
# 数据库连接字符串，不设置则使用 SQLite
# MySQL 示例：SQL_DSN=root:123456@tcp(localhost:3306)/oneapi
# PostgreSQL 示例：SQL_DSN=postgres://postgres:123456@localhost:5432/oneapi
#SQL_DSN=

# 日志数据库连接字符串，不设置则与主数据库共用
#LOG_SQL_DSN=

# ========================
# Redis 配置
# ========================
# Redis 连接字符串，不设置则不启用 Redis 缓存
#REDIS_CONN_STRING=redis://default:redispw@localhost:6379
# Redis 密码（集群/哨兵模式使用）
#REDIS_PASSWORD=
# Redis 主节点名称（哨兵模式使用）
#REDIS_MASTER_NAME=

# ========================
# 会话配置
# ========================
# 会话密钥，所有节点必须设置一样的值
#SESSION_SECRET=random_string

# ========================
# 缓存与同步配置
# ========================
# 启用内存缓存，会导致用户额度的更新存在一定延迟
#MEMORY_CACHE_ENABLED=true
# 缓存同步频率（秒），默认 600
#SYNC_FREQUENCY=600

# ========================
# 渠道配置
# ========================
# 渠道测试频率（分钟），不设置则不进行定期测试
#CHANNEL_TEST_FREQUENCY=1440
# 渠道余额更新频率（分钟），不设置则不进行定期更新
#CHANNEL_UPDATE_FREQUENCY=1440
# 渠道默认冷却时间（秒），默认 60
#CHANNEL_DEFAULT_COOLDOWN_SECONDS=60
# 渠道最大冷却时间（秒），默认 600
#CHANNEL_MAX_COOLDOWN_SECONDS=600
# 是否启用渠道并发限制
#CHANNEL_CONCURRENCY_ENABLED=false
# 是否启用渠道粘性会话
#CHANNEL_STICKY_SESSION_ENABLED=false

# ========================
# 批量更新配置
# ========================
# 启用数据库批量更新聚合，可减少数据库连接数
#BATCH_UPDATE_ENABLED=false
# 批量更新聚合的时间间隔（秒），默认 5
#BATCH_UPDATE_INTERVAL=5

# ========================
# 限流配置
# ========================
# 全局 API 速率限制（单 IP 三分钟内最大请求数），默认 480
#GLOBAL_API_RATE_LIMIT=480
# 全局 Web 速率限制（单 IP 三分钟内最大请求数），默认 240
#GLOBAL_WEB_RATE_LIMIT=240

# ========================
# 集群配置（不配置则以单节点模式运行）
# ========================
# 是否启用集群模式
#CLUSTER_ENABLED=true
# 节点编号（1-49），必须与 MySQL auto_increment_offset 一致，不同节点不能重复
#CLUSTER_NODE_ID=1
# 节点名称，便于识别
#CLUSTER_NODE_NAME=node-cn
# 本节点的公网访问地址，其他节点通过此地址推送数据（需包含协议前缀 https://）
#CLUSTER_NODE_ADDRESS=https://cn.example.com
# 节点间通信认证密钥，所有节点必须一致
#CLUSTER_SECRET=your-shared-secret-key
# 种子节点地址（逗号分隔，可选，用于首次启动时引导发现其他节点）
#CLUSTER_SEEDS=https://seed.example.com
# 同步事件推送间隔（秒），默认 3
#CLUSTER_PUSH_INTERVAL=3
# 节点发现间隔（秒），存活节点每周期互相 ping，默认 30
#CLUSTER_DISCOVERY_INTERVAL=30
# 失败节点 ping 间隔（秒），比存活间隔长以减少无效请求，默认 120
#CLUSTER_DEAD_PING_INTERVAL=120
# 连续 ping 失败次数，达到后标记节点为失败状态，默认 3
#CLUSTER_MAX_PING_FAILURES=3
# 是否同步日志表（logs 表数据量较大，按需开启），默认 true
#CLUSTER_SYNC_LOGS=true
# 每次推送最大事件数，默认 50
#CLUSTER_BATCH_SIZE=50

# ========================
# 其他配置
# ========================
# 中继超时时间（秒），不设置则无超时
#RELAY_TIMEOUT=0
# 中继代理地址
#RELAY_PROXY=
# 用户内容请求超时时间（秒），默认 30
#USER_CONTENT_REQUEST_TIMEOUT=30
# 用户内容请求代理地址
#USER_CONTENT_REQUEST_PROXY=
# 是否强制在 stream 模式下返回 usage
#ENFORCE_INCLUDE_USAGE=false
# Gemini 安全设置，默认 BLOCK_NONE
#GEMINI_SAFETY_SETTING=BLOCK_NONE
# Gemini 版本，默认 v1
#GEMINI_VERSION=v1
# 主题设置，默认 default
#THEME=default
# 是否启用指标监控，默认 false
#ENABLE_METRIC=false
# 测试模型时的提示语
#TEST_PROMPT=Output only your specific model name with no additional text.
# 初始 root 用户令牌
#INITIAL_ROOT_TOKEN=
# 初始 root 用户访问令牌
#INITIAL_ROOT_ACCESS_TOKEN=
# SQLite 锁等待超时（毫秒），默认 3000
#SQLITE_BUSY_TIMEOUT=3000
# SQLite 数据库路径，默认 one-api-pro.db
#SQLITE_PATH=one-api-pro.db